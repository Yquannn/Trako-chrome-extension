{
  "manifest_version": 3,
  "name": "Trako Order Exporter",
  "version": "0.1.0",
  "description": "Export order details visible on supported shopping sites to CSV.",
  "action": {
    "default_title": "Trako Order Exporter",
    "default_popup": "popup.html"
  },
  "permissions": ["downloads"],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    {
      "resources": ["assets/mascot-head.svg"],
      "matches": ["https://shopee.ph/*", "https://www.shopee.ph/*", "https://shop.tiktok.com/*", "https://lazada.com.ph/*", "https://www.lazada.com.ph/*", "https://shein.com/*", "https://*.shein.com/*", "https://temu.com/*", "https://*.temu.com/*", "https://pinduoduo.com/*", "https://*.pinduoduo.com/*", "https://yangkeduo.com/*", "https://*.yangkeduo.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://shopee.ph/*",
        "https://www.shopee.ph/*",
        "https://shop.tiktok.com/*",
        "https://lazada.com.ph/*",
        "https://www.lazada.com.ph/*",
        "https://shein.com/*",
        "https://*.shein.com/*",
        "https://temu.com/*",
        "https://*.temu.com/*",
        "https://pinduoduo.com/*",
        "https://*.pinduoduo.com/*",
        "https://yangkeduo.com/*",
        "https://*.yangkeduo.com/*"
      ],
      "js": ["export-core.js", "adapters.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
