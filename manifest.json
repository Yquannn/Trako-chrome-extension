{
  "manifest_version": 3,
  "name": "Trako – Order Exporter",
  "version": "0.2.2",
  "description": "Export online shopping orders to CSV locally. Supports Shopee PH and Lazada PH; SHEIN and other stores are planned.",
  "action": {
    "default_title": "Trako – Order Exporter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "permissions": [
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/mascot-head.svg"
      ],
      "matches": [
        "https://shopee.ph/*",
        "https://www.shopee.ph/*",
        "https://lazada.com.ph/*",
        "https://www.lazada.com.ph/*",
        "https://my.lazada.com.ph/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://my.lazada.com.ph/*"
      ],
      "js": [
        "lazada-navigation.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://shopee.ph/*",
        "https://www.shopee.ph/*",
        "https://lazada.com.ph/*",
        "https://www.lazada.com.ph/*",
        "https://my.lazada.com.ph/*"
      ],
      "js": [
        "export-core.js",
        "lazada-adapter.js",
        "adapters.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "minimum_chrome_version": "111"
}
